<aside class="sidebar">
  <a class="sidebar-brand" href="/staff/dashboard">
    <img src="/images/logo.png" alt="">
    <span>HOSPITAL SYSTEMS HELPDESK</span>
  </a>
  <nav class="side-nav" aria-label="Staff navigation">
    <% const navigationPages = [
      { path: "dashboard", label: "Dashboard", href: "/staff/dashboard" },
      { path: "tickets", label: "Ticket queue", href: "/staff/tickets" },
      { path: "machines", label: "Machines", href: "/staff/machines" },
      { path: "monitoring", label: "Monitoring", href: "/app/monitoring" },
      { path: "reports", label: "Reports", href: "/staff/reports" }
    ]; %>
    <% if (currentUser.role === "admin") { %>
      <% navigationPages.push({ path: "accounts", label: "Accounts", href: "/staff/accounts" }); %>
    <% } %>
    <% navigationPages.forEach((page) => { %>
      <a class="<%= activePage === page.path ? 'active' : '' %>" href="<%= page.href %>"><%= page.label %></a>
    <% }); %>
  </nav>
</aside>
