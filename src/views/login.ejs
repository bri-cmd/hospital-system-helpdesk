<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Hospital Systems Helpdesk</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="auth-page">
    <section class="login-brand-panel" aria-label="Brilliant Metal Craft and Machine Design OPC">
      <div class="login-brand-content">
        <img class="login-brand-logo" src="/images/logo.png" alt="Brilliant Metal Craft and Machine Design OPC logo">
        <h1>Brilliant Metal Craft and Machine Design OPC</h1>
        <p>Hospital Systems Helpdesk · Report plant issues, track tickets, monitor PMS</p>
      </div>
    </section>
    <main class="auth-card">
      <h1>Sign in</h1>
      <p class="auth-intro">For Hospital Systems staff and administrators.</p>
      <% if (error) { %>
        <p class="form-error" role="alert"><%= error %></p>
      <% } %>
      <form method="post" action="/login">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required autofocus>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button class="button button-blue auth-submit" type="submit">Sign in</button>
      </form>
      <p class="login-reset-note">Forgot your password? Ask a Hospital Systems administrator to reset it.</p>
      <p class="login-public-note">Hospital employees do not need to sign in. Open a ticket from the <a href="/">main page</a>.</p>
    </main>
  </body>
</html>
