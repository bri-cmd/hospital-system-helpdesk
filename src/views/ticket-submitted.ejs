<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Hospital Systems Helpdesk</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body class="ticket-success-page">
    <header class="public-header">
      <a class="public-header-brand" href="/">
        <img src="/images/logo.png" alt="">
        <span>Brilliant Metal Craft and Machine Design OPC</span>
      </a>
      <a class="public-signin" href="/login">Sign in</a>
    </header>
    <main class="ticket-success-content">
      <span class="success-check" role="img" aria-label="Success">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="m8 16 5 5L24 10" />
        </svg>
      </span>
      <h1>Request sent</h1>
      <p>Your ticket number is <strong><%= ticketNumber %></strong>.<br>Admin will look at it soon.</p>
      <a class="button button-blue" href="/tickets/status?ticketNumber=<%= ticketNumber %>">Check ticket status</a>
    </main>
  </body>
</html>
